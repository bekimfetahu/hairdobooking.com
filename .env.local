# Local Next.js env for proxy-based social login during development.
# Next.js talks to Laravel through the Docker network internally, while the browser sees localhost.
NEXT_PUBLIC_LARAVEL_URL=http://localhost
LARAVEL_INTERNAL_URL=http://hairdobooking

# Keep server-redirect off locally to avoid Google redirect_uri_mismatch.
NEXT_PUBLIC_FACEBOOK_SERVER_REDIRECT=false
NEXT_PUBLIC_GOOGLE_SERVER_REDIRECT=false

# Client-side provider IDs used by the Google popup flow and Facebook SDK flow.
NEXT_PUBLIC_FACEBOOK_APP_ID=2362576164235285
NEXT_PUBLIC_GOOGLE_CLIENT_ID=146057872877-ou3hdipf36u6tbikjqc383sqbuh51gtv.apps.googleusercontent.com
