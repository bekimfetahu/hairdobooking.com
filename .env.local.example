# Example Next.js env for server-redirect Social flows
# Set NEXT_PUBLIC_LARAVEL_URL to your Laravel app (used as default redirect target)
NEXT_PUBLIC_LARAVEL_URL=http://localhost

# Enable server redirect flows (Laravel Socialite)
NEXT_PUBLIC_FACEBOOK_SERVER_REDIRECT=true
NEXT_PUBLIC_FACEBOOK_REDIRECT_URL=http://localhost/client/auth/social/facebook/redirect

NEXT_PUBLIC_GOOGLE_SERVER_REDIRECT=true
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=http://localhost/client/auth/social/google/redirect

# Optional client-side IDs for fallback flows (not required for server redirect)
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
